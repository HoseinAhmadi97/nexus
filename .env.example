# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Same socket-based DSN pattern as Atlas: peer-auths as OS user `quant`
# over the local Postgres Unix socket, no password needed -- works
# only because Nexus runs as `quant` on the same box as Postgres.
NEXUS_PG_DSN=postgresql://quant@/quant_db?host=/var/run/postgresql

# Same Redis instance Atlas's RedisSink writes atlas:raw:{source}:{isin}
# into -- Nexus's primary read path (Postgres above is the fallback).
NEXUS_REDIS_URL=redis://127.0.0.1:6379/0

NEXUS_HOST=127.0.0.1
NEXUS_PORT=8100
